# STRAVA_CLIENT_ID=replace_with_your_client_id
# STRAVA_CLIENT_SECRET=replace_with_your_client_secret

# Optional. By default the server starts at 3000 and moves to the next free port.
# PORT=3000
# HOST=127.0.0.1
# STRAVA_REDIRECT_URI=http://localhost:3000/auth/strava/callback

# Optional. Max runs processed per detail/stream sync batch. Default: 40.
# STRAVA_MAX_DETAIL_SYNC_ACTIVITIES=40

# Cloud Run only. Local storage remains the default when these are omitted.
# RUNASIS_DEPLOYMENT_MODE=cloud
# RUNASIS_STORAGE_BACKEND=gcp
# RUNASIS_STORAGE_BUCKET=your-project-runasis-data
# RUNASIS_OWNER_ID=primary
# RUNASIS_PUBLIC_ORIGIN=https://your-runasis.vercel.app
# RUNASIS_ALLOWED_ATHLETE_ID=12345678
# RUNASIS_SESSION_SECRET=generate-at-least-32-random-bytes
# GOOGLE_CLOUD_PROJECT=your-project
# RUNASIS_CLOUD_RUN_URL=https://runasis-xxxxx.us-west1.run.app
# RUNASIS_TASK_LOCATION=us-west1
# RUNASIS_TASK_QUEUE=runasis-sync
# RUNASIS_TASK_SERVICE_ACCOUNT=runasis-tasks@your-project.iam.gserviceaccount.com
# RUNASIS_TASK_AUDIENCE=https://runasis-xxxxx.us-west1.run.app

# Vercel build only: the Cloud Run origin proxied under /api and /auth.
# RUNASIS_API_ORIGIN=https://runasis-xxxxx.us-west1.run.app
